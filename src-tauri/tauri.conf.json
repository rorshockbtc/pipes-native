{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pipes",
  "version": "0.1.0",
  "identifier": "pink.pipes.desktop",
  "build": {
    "frontendDist": "https://pipes.pink",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Pipes",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8080 http://localhost:3000 ws://localhost:3000 https://*.pipes.pink https://pipes.pink https://*.clerk.accounts.dev https://api.clerk.com; img-src 'self' data: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
