{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pipes Civic AirGap",
  "version": "0.1.0",
  "identifier": "pink.pipes.marigold.airgap",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pipes Civic AirGap (Marigold)",
        "url": "tauri://localhost/index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri:; connect-src 'self' tauri: http://127.0.0.1:11434 http://localhost:11434; img-src 'self' tauri: asset: data: blob:; font-src 'self' tauri: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
